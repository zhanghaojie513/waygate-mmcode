{
  "name": "waygate-mmcode",
  "version": "0.3.4",
  "description": "MiniMax Code 本地反代：官方 OAuth 设备授权登录，提供 Anthropic/OpenAI 兼容的本地聊天端点",
  "keywords": [
    "minimax",
    "minimax-code",
    "mmcode2api",
    "reverse-proxy",
    "openai-compatible",
    "anthropic",
    "claude-code",
    "cursor",
    "checkin",
    "credits"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhanghaojie513/waygate-mmcode.git"
  },
  "homepage": "https://github.com/zhanghaojie513/waygate-mmcode#readme",
  "bugs": {
    "url": "https://github.com/zhanghaojie513/waygate-mmcode/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "mmcode": "dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.test.json",
    "dev": "node --experimental-strip-types src/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "waygate-core": "^0.2.8"
  }
}
